<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <TargetFramework>net10.0-windows</TargetFramework>
        <AssemblyName>FireIV</AssemblyName>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <PropertyGroup>
        <NoWarn>CS1998;1701;1702;CS0414;CS8601;CS8602;CS8604;CS8603;IDE1006;IDE0300;MSB3270;MSB324;CS0649;CA2211;CS8509;CS8625;MSB3305;CS8618;CS8600;CS8605;CS8620;CS0436;CS0169;CS0105;CS1591</NoWarn>
        <WarningsAsErrors>CS4014</WarningsAsErrors>
        <BaseOutputPath>C:\everyone\AEAssist7.4\ACR\FireIV</BaseOutputPath>
    </PropertyGroup>

    
    <ItemGroup>
        <PackageReference Include="AEAssist.NET" Version="*" ExcludeAssets="runtime" />
    </ItemGroup>

    
    <ItemGroup>
      <Folder Include="src\SlottSequences\" />
      <Folder Include="src\Settings\" />
